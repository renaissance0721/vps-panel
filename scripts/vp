#!/usr/bin/env bash

set -Eeuo pipefail

readonly INSTALL_DIR="/opt/vps-panel/panel"
readonly INSTALL_MARKER="${INSTALL_DIR}/.vps-panel-install"
readonly DATA_DIR="/var/lib/vps-panel/panel"
readonly CONFIG_DIR="/etc/vps-panel/panel"
readonly CONFIG_FILE="${CONFIG_DIR}/environment"
readonly SERVICE_FILE="/etc/systemd/system/vps-panel.service"
readonly SERVICE_NAME="vps-panel.service"
readonly COMMAND_PATH="/usr/local/bin/vp"
readonly CADDY_FILE="/etc/caddy/Caddyfile"
readonly CADDY_SNIPPET="/etc/caddy/vps-panel.caddy"
readonly CADDY_IMPORT="import /etc/caddy/vps-panel.caddy"
readonly REMOTE_INSTALLER="https://raw.githubusercontent.com/renaissance0721/vps-panel/main/scripts/install-panel.sh"

fail() {
  printf '[vps-panel] Error: %s\n' "$*" >&2
  exit 1
}

require_installation() {
  [[ ${EUID} -eq 0 ]] || fail "run vp as root"
  command -v systemctl >/dev/null 2>&1 || fail "systemctl is not installed"
  [[ -x "${INSTALL_DIR}/vps-panel" && -f "$INSTALL_MARKER" && -f "$SERVICE_FILE" ]] || \
    fail "VPS Panel is not installed in ${INSTALL_DIR}"
}

current_domain() {
  local domain=""
  if [[ -f "$CONFIG_FILE" ]]; then
    domain="$(sed -n 's/^PANEL_DOMAIN=//p' "$CONFIG_FILE" | tail -n 1)"
  fi
  printf '%s\n' "${domain:-:80}"
}

wait_for_panel() {
  local response=""
  for _ in {1..30}; do
    if response="$(curl -fsS --connect-timeout 2 --max-time 4 \
      http://127.0.0.1:8080/api/health 2>/dev/null)"; then
      if [[ "$response" == *'"status":"ok"'* ]]; then
        return 0
      fi
    fi
    sleep 2
  done
  return 1
}

run_latest_installer() {
  local domain="$1"
  local temporary_installer=""
  local exit_code=0

  command -v curl >/dev/null 2>&1 || fail "curl is not installed"
  temporary_installer="$(mktemp)"
  curl --proto '=https' --tlsv1.2 -fL --retry 3 --retry-delay 2 \
    "$REMOTE_INSTALLER" \
    -o "$temporary_installer"
  bash "$temporary_installer" --domain "$domain" || exit_code=$?
  rm -f -- "$temporary_installer"
  return "$exit_code"
}

update_panel() {
  local domain=""
  domain="$(current_domain)"
  printf '[vps-panel] Updating Panel from the latest GitHub Release...\n'
  run_latest_installer "$domain"
}

change_domain() {
  local domain=""
  printf 'New domain, or :80 for IP:8080 access: '
  IFS= read -r domain
  if [[ -z "$domain" ]]; then
    printf '[vps-panel] Domain was not changed.\n'
    return
  fi
  run_latest_installer "$domain"
}

show_status() {
  local domain=""
  domain="$(current_domain)"
  if [[ "$domain" == ":80" ]]; then
    printf '[vps-panel] Access: http://YOUR_VPS_IP:8080\n'
  else
    printf '[vps-panel] Access: https://%s\n' "$domain"
  fi
  systemctl status "$SERVICE_NAME" --no-pager
  if [[ "$domain" != ":80" && -f "$CADDY_SNIPPET" ]]; then
    systemctl status caddy.service --no-pager
  fi
}

show_logs() {
  journalctl -u "$SERVICE_NAME" -n 100 -f
}

restart_panel() {
  command -v curl >/dev/null 2>&1 || fail "curl is not installed"
  systemctl restart "$SERVICE_NAME"
  if ! wait_for_panel; then
    systemctl status "$SERVICE_NAME" --no-pager >&2 || true
    fail "Panel did not become healthy within 60 seconds"
  fi
  printf '[vps-panel] Panel restarted successfully.\n'
}

remove_caddy_configuration() {
  local filtered_caddyfile=""

  rm -f -- "$CADDY_SNIPPET"
  if [[ -f "$CADDY_FILE" ]] && grep -Fqx "$CADDY_IMPORT" "$CADDY_FILE"; then
    filtered_caddyfile="$(mktemp)"
    grep -Fvx "$CADDY_IMPORT" "$CADDY_FILE" >"$filtered_caddyfile" || true
    install -m 0644 "$filtered_caddyfile" "$CADDY_FILE"
    rm -f -- "$filtered_caddyfile"
  fi
  if command -v caddy >/dev/null 2>&1 && systemctl is-active --quiet caddy.service; then
    if caddy validate --config "$CADDY_FILE" >/dev/null 2>&1; then
      systemctl reload caddy.service
    fi
  fi
}

uninstall_panel() {
  local confirmation=""
  local delete_data=""
  local shared_root=""

  printf 'Type uninstall to remove VPS Panel: '
  IFS= read -r confirmation
  if [[ "$confirmation" != "uninstall" ]]; then
    printf '[vps-panel] Uninstall cancelled.\n'
    return
  fi

  printf 'Also permanently delete SQLite data? [y/N]: '
  IFS= read -r delete_data

  [[ "$INSTALL_DIR" == "/opt/vps-panel/panel" ]] || fail "unexpected installation path"
  [[ "$DATA_DIR" == "/var/lib/vps-panel/panel" ]] || fail "unexpected data path"
  [[ "$CONFIG_DIR" == "/etc/vps-panel/panel" ]] || fail "unexpected config path"
  [[ "$COMMAND_PATH" == "/usr/local/bin/vp" ]] || fail "unexpected command path"
  for shared_root in /opt/vps-panel /var/lib/vps-panel /etc/vps-panel; do
    [[ ! -L "$shared_root" ]] || fail "shared root must not be a symbolic link: $shared_root"
  done
  systemctl disable --now "$SERVICE_NAME" >/dev/null 2>&1 || true
  remove_caddy_configuration
  rm -f -- "$SERVICE_FILE"
  systemctl daemon-reload
  rm -rf -- "$INSTALL_DIR" "$CONFIG_DIR"

  if [[ "$delete_data" == "y" || "$delete_data" == "Y" ]]; then
    rm -rf -- "$DATA_DIR"
    printf '[vps-panel] Panel and SQLite data removed.\n'
  else
    printf '[vps-panel] Panel removed. SQLite data was preserved in %s.\n' "$DATA_DIR"
  fi
  rm -f -- "$COMMAND_PATH"
  exit 0
}

usage() {
  cat <<'EOF'
Usage: vp [command]

Commands:
  update      Download and install the latest GitHub Release
  domain      Change the Panel domain or switch to IP:8080 access
  status      Show systemd service status
  logs        Follow Panel logs from journald
  restart     Restart Panel and run a health check
  uninstall   Remove VPS Panel interactively
  help        Show this help message

Run vp without a command to open the interactive menu.
EOF
}

pause_menu() {
  printf '\nPress Enter to return to the menu...'
  IFS= read -r _
}

menu() {
  [[ -t 0 ]] || fail "interactive menu requires a terminal; use vp help"

  while true; do
    cat <<EOF

VPS Panel Management
====================
Domain: $(current_domain)

1) Update Panel
2) Change domain
3) Show status
4) View logs
5) Restart Panel
6) Uninstall Panel
0) Exit
EOF
    printf 'Select an option: '
    IFS= read -r selection

    case "$selection" in
      1) update_panel ;;
      2) change_domain ;;
      3)
        show_status
        pause_menu
        ;;
      4)
        show_logs
        pause_menu
        ;;
      5)
        restart_panel
        pause_menu
        ;;
      6) uninstall_panel ;;
      0) exit 0 ;;
      *) printf '[vps-panel] Invalid option.\n' ;;
    esac
  done
}

case "${1:-menu}" in
  help | -h | --help)
    usage
    exit 0
    ;;
esac

require_installation

case "${1:-menu}" in
  menu) menu ;;
  update) update_panel ;;
  domain) change_domain ;;
  status) show_status ;;
  logs) show_logs ;;
  restart) restart_panel ;;
  uninstall) uninstall_panel ;;
  *)
    usage >&2
    exit 1
    ;;
esac
